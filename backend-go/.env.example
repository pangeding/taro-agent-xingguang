# 数据库驱动：mysql | sqlite | 留空（自动：MYSQL_HOST 非空则 mysql）
DB_DRIVER=mysql

# SQLite 回退路径（DB_DRIVER=sqlite 时生效）
DATABASE_URL=data/tarot.db

# MySQL（WSL2 访问 Windows 主机：host = 默认网关，用 `ip route show default` 复查）
MYSQL_HOST=172.23.96.1
MYSQL_PORT=3306
MYSQL_DB=tarot
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============ 用户系统 ============
# dev | prod。prod 会启用三重生产保护（引导口令校验 / 弱口令扫描 / 强制改密门禁），
# 详见 doc/2026-09-28-用户系统与数据隔离技术文档.md §3.3。
APP_ENV=dev

# 首个账号（仅当 users 表为空时生效）。
# dev 留空 -> admin / 123456，开箱即用。
# prod 必填，且：用户名不得为 admin/root/administrator/test/guest/user 等保留字，
#            密码长度 >= 12 且不得命中弱口令表。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 会话
SESSION_COOKIE_NAME=tarot_session
SESSION_TTL_HOURS=720
# 留空 = 跟随 APP_ENV（prod 时为 true）。仅在本地以 http 跑 prod 调试时才需要显式设 false。
COOKIE_SECURE=

# 留空 = prod 绑 127.0.0.1:8000（由 nginx 反代），dev 绑 :8000
BIND_ADDR=
